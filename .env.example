# Скопируйте файл в .env и заполните значения перед запуском.
# Не коммитьте .env и никогда не публикуйте реальные значения.
VK_TOKEN=replace-with-vk-community-token
ACTIVATION_PASSWORD=replace-with-demo-password
QUIZ_ENABLED=true
POSTGRES_DB=qrver_vk_quiz_robot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-db-password
VK_API_LIMIT=20
